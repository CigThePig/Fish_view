{
  "name": "fish-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent 800 × 480 landscape ASCII aquarium.",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test",
    "verify": "npm test && npm run audit:simulation && npm run audit:persistence -- --cases=200 && npm run audit:render && npm run measure:feeding && npm run measure:relationship",
    "audit:simulation": "node tools/audit-simulation.mjs",
    "audit:render": "node tools/audit-render.mjs",
    "audit:persistence": "node tools/audit-persistence.mjs",
    "measure:readability": "node tools/measure-behavior-readability.mjs",
    "measure:stage2-baseline": "node tools/measure-stage2-baseline.mjs",
    "measure:water": "node tools/measure-water-response.mjs",
    "measure:environment": "node tools/measure-environment-response.mjs",
    "observe:interaction": "node tools/observe-interaction.mjs",
    "measure:screen": "node tools/measure-screen-legibility.mjs",
    "measure:feeding": "node tools/measure-substrate-feeding.mjs",
    "measure:relationship": "node tools/measure-viewer-relationship.mjs",
    "capture:behaviors": "node tools/capture-behavior-showcase.mjs",
    "capture:interaction": "node tools/capture-interaction.mjs",
    "capture:depth": "node tools/capture-habitat-depth.mjs",
    "capture:living": "node tools/capture-living-aquarium.mjs",
    "measure:living": "node tools/measure-living-aquarium.mjs",
    "dev": "node tools/serve.mjs",
    "build:pages": "node tools/build-pages.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-or-later"
}
